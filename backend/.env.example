# Application Configuration
APP_TITLE=Receipt Vault & Analyzer

# Database Configuration
# DB_PATH=./data/receipts.db

# Authentication & Security
# IMPORTANT: Generate a secure key for production
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=dev-only-insecure-secret-change-me
JWT_EXPIRE_MINUTES=1440

# CORS - Allowed frontend origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# OCR Configuration
OCR_LANG=en
OCR_ENGINE=auto

# Windows-specific OCR paths (uncomment and set if needed)
# TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe
# POPPLER_PATH=C:\poppler-25.12.0\Library\bin

# File Upload Configuration
MAX_FILE_SIZE_MB=10

# Email/SMS Alerts (optional)
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# GMAIL_USER=your-email@gmail.com
# GMAIL_PASS=your-app-password
